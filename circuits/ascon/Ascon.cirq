circuit: hash.circom
ast: hash.json
proof: Ascon.v
imports: [Primitives, Bitwise]

definitions:
  iterate:
    type: Fixpoint
    signature: "(f : A -> A) (n : nat) (x : A) -> A"
    description: n-fold iteration of a function f starting from x

templates:
  Ascon_Hash_256:
    source: hash.circom:7-40
    constraints:
      - initialize state from ASCON_INITIAL_STATE_HASH_256
      - "absorb: for each block, state = Permutation(12)(Absorb(state, block))"
      - "squeeze: 4 iterations of Permutation(12), extracting S0 each time"
    notes: >
      Ascon-Hash-256: absorb nBlocks of 64-bit input then squeeze 4 words.
      Output is 4 x 64 = 256 bits. Proof covers sub-components:
      S-box (5 Boolean functions proven binary via exhaustive 32-case analysis),
      ConstantAddition (XOR round constant into S2[56..63]),
      LinearDiffusion (XOR with two shifts, proven binary-preserving),
      Absorb (XOR input into S0, proven binary-preserving),
      and full Permutation (composition of rnd rounds).
    properties:
      Ascon_Sbox_y0_correct:
        type: Theorem
        statement: is_binary y0
        assumes:
          - is_binary x0..x4
          - "y0 = xor_bit chain: x4*x1 XOR x3 XOR x2*x1 XOR x2 XOR x1*x0 XOR x1 XOR x0"
        technique: exhaustive case analysis on all 32 binary input combinations
        depends_on:
          - Primitives.is_binary
          - Bitwise.xor_bit
      Ascon_Sbox_y1_correct:
        type: Theorem
        statement: is_binary y1
        assumes:
          - is_binary x0..x4
          - "y1 = xor_bit chain: x4 XOR x3*x2 XOR x3*x1 XOR x3 XOR x2*x1 XOR x2 XOR x1 XOR x0"
        technique: exhaustive case analysis on all 32 binary input combinations
        depends_on:
          - Primitives.is_binary
          - Bitwise.xor_bit
      Ascon_Sbox_y2_correct:
        type: Theorem
        statement: is_binary y2
        assumes:
          - is_binary x0..x4
          - "y2 = xor_bit chain: x4*x3 XOR x4 XOR x2 XOR x1 XOR 1"
        technique: exhaustive case analysis on all 32 binary input combinations
        depends_on:
          - Primitives.is_binary
          - Bitwise.xor_bit
      Ascon_Sbox_y3_correct:
        type: Theorem
        statement: is_binary y3
        assumes:
          - is_binary x0..x4
          - "y3 = xor_bit chain: x4*x0 XOR x4 XOR x3*x0 XOR x3 XOR x2*x1 XOR x2 XOR x1 XOR x0"
        technique: exhaustive case analysis on all 32 binary input combinations
        depends_on:
          - Primitives.is_binary
          - Bitwise.xor_bit
      Ascon_Sbox_y4_correct:
        type: Theorem
        statement: is_binary y4
        assumes:
          - is_binary x0..x4
          - "y4 = xor_bit chain: x4*x1 XOR x4 XOR x3 XOR x1*x0 XOR x1"
        technique: exhaustive case analysis on all 32 binary input combinations
        depends_on:
          - Primitives.is_binary
          - Bitwise.xor_bit
      Ascon_Sbox_Circuit_binary:
        type: Theorem
        statement: >
          is_binary y0 /\ is_binary y1 /\ is_binary y2 /\
          is_binary y3 /\ is_binary y4
        assumes:
          - is_binary x0..x4
          - S-box equations y0..y4 as xor_bit chains of inputs
        technique: apply Ascon_Sbox_y0..y4_correct for each output
        depends_on:
          - Ascon_Sbox_y0_correct
          - Ascon_Sbox_y1_correct
          - Ascon_Sbox_y2_correct
          - Ascon_Sbox_y3_correct
          - Ascon_Sbox_y4_correct
      Ascon_ConstantAddition_spec:
        type: Theorem
        statement: all_binary S2_out
        assumes:
          - length S2_in = 64, length S2_out = 64, length constant = 8
          - all_binary S2_in, all_binary constant
          - first 56 bits unchanged
          - last 8 bits XORed with constant
        technique: >
          Forall_forall + In_nth to get index k, case split on k < 56 vs >= 56.
          First case: copied from binary S2_in. Second case: xor_bit_binary.
        depends_on:
          - Primitives.all_binary
          - Primitives.xor_bit_binary
      Ascon_LinearDiffusion_Layer_spec:
        type: Theorem
        statement: all_binary out
        assumes:
          - length inp = 64, length out = 64
          - all_binary inp
          - "forall k < 64, out[k] = xor_bit(xor_bit(in[k], in[(k+shift_a) mod 64]), in[(k+shift_b) mod 64])"
        technique: >
          Forall_forall + In_nth to get index k, rewrite via xor constraint,
          extract binary assumptions for three input bits via Forall_nth,
          exhaustive case analysis on the three binary values
        depends_on:
          - Primitives.all_binary
          - Bitwise.xor_bit
      Ascon_Absorb_spec:
        type: Theorem
        statement: all_binary S0_out
        assumes:
          - length S0_in = 64, length inp = 64, length S0_out = 64
          - all_binary S0_in, all_binary inp
          - "forall k < 64, S0_out[k] = xor_bit(S0_in[k], inp[k])"
        technique: >
          Forall_forall + In_nth, rewrite via xor constraint, extract
          binary assumptions via Forall_nth, case analysis on two binary values
        depends_on:
          - Primitives.all_binary
          - Bitwise.xor_bit
      Ascon_Permutation_spec:
        type: Theorem
        statement: >
          length (iterate round_fn rnd init) = 320 /\
          all_binary (iterate round_fn rnd init)
        assumes:
          - rnd > 0
          - length init = 320, all_binary init
          - round_fn preserves length = 320 and all_binary
        technique: induction on rnd, base case from init, step applies round_fn hypothesis to IH
        depends_on:
          - iterate (local Fixpoint)
      Ascon_Hash_256_spec:
        type: Theorem
        statement: 0 <= bits_to_num out < 2^256
        assumes:
          - nBlocks > 0
          - length out = 256, all_binary out
        technique: apply bits_to_num_bound, rewrite length
        depends_on:
          - Primitives.bits_to_num_bound
