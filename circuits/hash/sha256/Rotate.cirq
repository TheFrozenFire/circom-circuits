circuit: rotate.circom
ast: rotate.json
proof: Rotate.v
imports: [Primitives]

templates:
  RotR:
    source: rotate.circom:4-11
    constraints: []
    notes: pure rewiring — no R1CS constraints
    properties:
      RotR_spec:
        type: Theorem
        statement: forall i, nth i out 0 = nth ((i + r) mod n) inp 0
        assumes:
          - length inp = n, length out = n
          - forall i < n, nth i out 0 = nth ((i + r) mod n) inp 0
        technique: direct from assumption
        depends_on: []
        placeholder: true
        notes: restates rewiring constraint (no R1CS — pure signal permutation)
