circuit: shift.circom
ast: shift.json
proof: Shift.v
imports: [Primitives]

templates:
  ShR:
    source: shift.circom:4-15
    constraints: []
    notes: pure rewiring — no R1CS constraints
    properties:
      ShR_spec:
        type: Theorem
        statement: "forall i, nth i out 0 = if (i + r < n) then nth (i + r) inp 0 else 0"
        assumes:
          - length inp = n, length out = n
          - forall i < n, nth i out 0 = if (i+r <? n) then nth (i+r) inp 0 else 0
        technique: direct from assumption
        depends_on: []
        wiring: true
        notes: signal routing wiring — no R1CS constraints to derive from
