circuit: sha256compression.circom
ast: sha256compression.json
proof: Sha256compression.v
imports: [Primitives, T1, T2, SigmaPlus, BinSum]

definitions:
  sha256_state:
    type: Definition
    signature: "(Z * Z * Z * Z * Z * Z * Z * Z)"
    description: 8-word SHA-256 state tuple (a, b, c, d, e, f, g, h)
  sha256_round_step:
    type: Definition
    signature: "sha256_state -> Z -> Z -> Z -> Z -> Z -> Z -> sha256_state"
    description: >
      one round of state evolution: (new_a, a, b, c, new_e, e, f, g)
      where new_a = T1 + T2 and new_e = d + T1

templates:
  Sha256compression:
    source: sha256compression.circom:11-143
    constraints:
      - w[t] for t < 16: wired from inp (reversed bit order per word)
      - w[t] for t >= 16: SigmaPlus(w[t-2], w[t-7], w[t-15], w[t-16])
      - state[0] initialized from hin (8 words)
      - "64 rounds: T1, T2, BinSum for new_a and new_e, state rotation"
      - fsum[i] = BinSum(32,2)(hin[i], state[64][i]) for output
    notes: >
      one block of SHA-256 compression (64 rounds). Message schedule
      expands 16 input words to 64 via SigmaPlus. State evolves through
      T1/T2 computation and BinSum additions.
    properties:
      message_schedule_direct:
        type: Theorem
        statement: all_binary w_t
        assumes:
          - t < 16
          - length w_t = 32
          - all_binary inp
          - length inp >= (t + 1) * 32
          - direct wiring constraints
        technique: Forall_nth, rewrite via wiring, extract binary from all_binary inp
        depends_on:
          - Primitives.all_binary
      message_schedule_expansion:
        type: Theorem
        statement: 0 <= bits_to_num w_t < 2^32
        assumes:
          - length w_t = 32, all_binary w_t
          - SigmaPlus constraint holds
        technique: apply bits_to_num_bound, rewrite length
        depends_on:
          - Primitives.bits_to_num_bound
      state_evolution_correct:
        type: Theorem
        statement: >
          sha256_round_step(a,b,c,d,e,f,g,h, t1, t2, new_a, new_e) =
          (new_a, a, b, c, new_e, e, f, g)
        assumes: []
        technique: reflexivity (definitional)
        depends_on: [sha256_round_step]
      final_addition_correct:
        type: Theorem
        statement: 0 <= bits_to_num fsum_out < 2^32
        assumes:
          - all_binary fsum_out
          - length fsum_out = 32
          - BinSum constraint holds
        technique: apply bits_to_num_bound, rewrite length
        depends_on:
          - Primitives.bits_to_num_bound
      Sha256compression_complete:
        type: Theorem
        statement: for binary hin (256 bits) and inp (512 bits), exists w, state, out satisfying all Sha256compression constraints
        technique: witness message schedule and state evolution, verify round constraints
        depends_on: [BinSum_complete]
      Sha256compression_spec:
        type: Theorem
        statement: 0 <= bits_to_num out < 2^256
        assumes:
          - length hin = 256, length inp = 512, length out = 256
          - all_binary out
        technique: apply bits_to_num_bound, rewrite length
        depends_on:
          - Primitives.bits_to_num_bound
