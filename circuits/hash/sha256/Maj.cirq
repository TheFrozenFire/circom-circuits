circuit: maj.circom
ast: maj.json
proof: Maj.v
imports: [Primitives]

templates:
  Maj:
    source: maj.circom:5-16
    constraints:
      - mid[k] = b[k] * c[k]
      - out[k] = a[k] * (b[k] + c[k] - 2*mid[k]) + mid[k]
    notes: SHA-256 majority function — maj(a,b,c) = (a AND b) XOR (a AND c) XOR (b AND c)
    properties:
      Maj_correct:
        type: Theorem
        statement: out = maj_bit a b c /\ is_binary out
        assumes:
          - is_binary a, is_binary b, is_binary c
          - mid = b * c
          - out = a * (b + c - 2*mid) + mid
        technique: case analysis on all 8 combinations of a, b, c binary values
        depends_on: [Primitives.maj_bit, Primitives.is_binary]
