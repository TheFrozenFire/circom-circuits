circuit: bigint.circom
ast: bigint.json
proof: BigInt.v
imports: [Primitives]

definitions:
  convolution_at:
    type: Definition
    signature: "(a b : list Z) (l : nat) -> Z"
    description: sum of pairwise products a[i] * b[l-i] for i in 0..l
  nth_succ_cons:
    type: Fact
    statement: nth (S i) (x :: l) 0 = nth i l 0
    notes: definitionally true; used to shift indices during induction
  nth_tl:
    type: Lemma
    statement: (i >= 1) -> nth i (x :: l) 0 = nth (i - 1) l 0
    notes: generalizes nth_succ_cons for opaque i >= 1
  nth_cons_if_eqb:
    type: Lemma
    statement: nth i (x :: l) 0 = if (i =? 0) then x else nth (i-1) l 0
    notes: helper for nth on cons using boolean equality
  nth_firstn_lt:
    type: Lemma
    statement: (i < n) -> nth i (firstn n l) 0 = nth i l 0
    notes: helper for nth on firstn when index is in bounds
  big_lt_chain:
    type: Fixpoint
    signature: "(lt_vals eq_vals : list Z) -> Z"
    description: recursive comparison chain; lt + eq * recursive_result
  big_add_witness_aux:
    type: Fixpoint
    signature: "(a b : list Z) (carry_in : Z) -> list Z * list Z"
    description: recursive computation of (outs, carries) from input limbs with carry propagation
  big_add_witness:
    type: Definition
    signature: "(n : nat) (a b : list Z) -> list Z * list Z"
    description: top-level BigAdd witness computation wrapping big_add_witness_aux with carry_in=0
  big_add_witness_aux_lengths:
    type: Lemma
    statement: length outs = length a + 1 /\ length carries = length a
    notes: proves output and carry lists have correct lengths
  big_add_witness_aux_correct:
    type: Lemma
    statement: per-limb constraint equations hold for witness computation
    notes: proves BigAdd constraints are satisfied by witness values
  big_sub_witness_aux:
    type: Fixpoint
    signature: "(a b : list Z) (borrow_in : Z) -> list Z * list Z"
    description: recursive computation of (outs, borrows) from input limbs with borrow propagation
  big_sub_witness:
    type: Definition
    signature: "(n : nat) (a b : list Z) -> list Z * list Z"
    description: top-level BigSub witness computation, dropping final borrow
  big_sub_witness_aux_lengths:
    type: Lemma
    statement: length outs = length a /\ length borrows = length a - 1
    notes: proves output and borrow lists have correct lengths
  big_sub_witness_aux_correct:
    type: Lemma
    statement: per-limb constraint equations hold for witness computation
    notes: proves BigSub constraints are satisfied by witness values
  big_sub_witness_aux_value:
    type: Lemma
    statement: limbs_to_num(a) - borrow_in - limbs_to_num(b) = limbs_to_num(out)
    notes: proves value preservation through borrow propagation
  carry_chain_aux:
    type: Fixpoint
    signature: "(inp : list Z) (carry_in : Z) -> list Z * list Z"
    description: recursive carry propagation computation
  carry_chain_aux_lengths:
    type: Lemma
    statement: length outs = length inp /\ length carries = length inp
    notes: proves output and carry lists have correct lengths
  carry_chain_aux_correct:
    type: Lemma
    statement: per-limb constraint equations hold for carry chain computation
    notes: proves carry propagation constraints are satisfied by witness values
  limbs_to_num_snoc:
    type: Lemma
    statement: limbs_to_num n (l ++ [x]) = limbs_to_num n l + x * 2^(n * length l)
    notes: helper for limbs_to_num with appended element
  limbs_to_num_firstn_skipn:
    type: Lemma
    statement: limbs_to_num n l = limbs_to_num n (firstn k l) + 2^(n*k) * limbs_to_num n (skipn k l)
    notes: helper for splitting limbs_to_num via firstn/skipn
  carry_chain_aux_value:
    type: Lemma
    statement: limbs_to_num(inp) + carry_in = limbs_to_num(out) + final_carry * 2^(n * length inp)
    notes: proves value preservation through carry chain
  carry_propagation_complete:
    type: Lemma
    statement: for any input list, exists carries satisfying carry propagation constraints
    notes: constructs witness carries for CheckCarryToZero and LongToShortNoEndCarry completeness
  big_mod_inv:
    type: Parameter
    signature: "nat -> nat -> list Z -> list Z -> list Z"
    description: axiomatized modular inverse witness computation
  big_mod_inv_length:
    type: Axiom
    statement: forall n k a p, length (big_mod_inv n k a p) = k
    description: modular inverse witness has k limbs
  big_mod_inv_range:
    type: Axiom
    statement: forall n k a p i, i < k -> 0 <= nth i (big_mod_inv n k a p) 0 < 2^n
    description: modular inverse limbs are in range [0, 2^n)
  big_mod_inv_spec:
    type: Axiom
    statement: >
      forall n k a p, limbs_to_num n p > 0 ->
      (limbs_to_num n a * limbs_to_num n (big_mod_inv n k a p)) mod (limbs_to_num n p) = 1
    description: modular inverse satisfies a * inv mod p = 1

templates:
  CheckCarryToZero:
    source: bigint.circom:10-34
    constraints:
      - inp[0] = carries[0] * 2^n
      - inp[i] + carries[i-1] = carries[i] * 2^n (for 0 < i < k-1)
      - inp[k-1] + carries[k-2] = 0
    properties:
      limbs_to_num_repeat_zero:
        type: Lemma
        statement: limbs_to_num n (repeat 0 k) = 0
        assumes: []
        technique: induction on k, limbs_to_num_cons
        depends_on: [Primitives.limbs_to_num_cons]
      CheckCarryToZero_correct:
        type: Theorem
        statement: limbs_to_num n inp = 0
        assumes:
          - k >= 2
          - length inp = k, length carries = k - 1
          - "inp[0] = carries[0] * 2^n"
          - "forall i, 0 < i < k-1 -> inp[i] + carries[i-1] = carries[i] * 2^n"
          - "inp[k-1] + carries[k-2] = 0"
        technique: >
          show limbs_to_num inp = limbs_to_num (repeat 0 k) via
          carry_propagation_preserves_value with carries ++ [0] (padding
          carries from k-1 to k entries; final carry forced to 0 via
          app_nth2_plus). Three cases for the uniform equation: i=0 uses H0,
          0 < i < k-1 uses Hmid with app_nth1, i=k-1 uses Hfinal with
          carries[k-1]=0. Then limbs_to_num_repeat_zero.
        depends_on:
          - Primitives.carry_propagation_preserves_value
      CheckCarryToZero_field_safe:
        type: Theorem
        statement: for n+m+1 <= 253, all constraint values (inp, carries) remain in [0, p_field)
        technique: bound analysis on carry values with n+m+1 <= 253
        depends_on: []
      CheckCarryToZero_complete:
        type: Theorem
        statement: for k >= 2 and limbs_to_num(inp) = 0, exists carries satisfying all CheckCarryToZero constraints
        technique: apply carry_propagation_complete, verify final carry is 0 from value = 0
        depends_on: [carry_propagation_complete]

  LongToShortNoEndCarry:
    source: bigint.circom:38-62
    constraints:
      - inp[0] = out[0] + carries[0] * 2^n
      - inp[i] + carries[i-1] = out[i] + carries[i] * 2^n (for 0 < i < k-1)
      - out[k-1] = inp[k-1] + carries[k-2]
    properties:
      LongToShortNoEndCarry_correct:
        type: Theorem
        statement: limbs_to_num n inp = limbs_to_num n out
        assumes:
          - k >= 2
          - length inp = k, length out = k, length carries = k - 1
          - "inp[0] = out[0] + carries[0] * 2^n"
          - "forall i, 0 < i < k-1 -> inp[i] + carries[i-1] = out[i] + carries[i] * 2^n"
          - "out[k-1] = inp[k-1] + carries[k-2]"
        technique: >
          apply carry_propagation_preserves_value with carries ++ [0] (pad
          carries from k-1 to k entries). Three cases: i=0 uses H0 with
          app_nth1, 0 < i < k-1 uses Hmid with app_nth1, i=k-1 rewrites
          carries[k-1] to 0 via app_nth2_plus then Z.mul_0_l.
        depends_on:
          - Primitives.carry_propagation_preserves_value
      LongToShortNoEndCarry_complete:
        type: Theorem
        statement: for k >= 2 and n-bit inp limbs, exists out carries satisfying LongToShortNoEndCarry constraints with limbs_to_num(inp) = limbs_to_num(out)
        technique: apply carry_propagation_complete, extract out limbs as remainders
        depends_on: [carry_propagation_complete]

  BigAdd:
    source: bigint.circom:66-96
    constraints:
      - a[0] + b[0] = out[0] + carries[0] * 2^n
      - a[i] + b[i] + carries[i-1] = out[i] + carries[i] * 2^n
      - out[k] = carries[k-1]
    properties:
      bigadd_with_carry:
        type: Lemma
        statement: carry_in + limbs_to_num n a + limbs_to_num n b = limbs_to_num n out
        assumes:
          - length a = length b, length out = length a + 1, length carries = length a
          - length a >= 1
          - "a[0] + b[0] + carry_in = out[0] + carries[0] * 2^n"
          - "forall i, 0 < i < length a -> a[i] + b[i] + carries[i-1] = out[i] + carries[i] * 2^n"
          - "out[length a] = carries[length a - 1]"
        technique: >
          induction on list a, destructing b/out/carries in parallel via
          nested destruct. Base case (length a = 1): destruct all to single
          elements, limbs_to_num_nil + lia. Inductive step: peel head limb,
          build shifted hypotheses H0'/Hmid'/Hfinal' via nth_succ_cons and
          nth_tl, apply IH with carry_in = c0 (first carry), lia.
        depends_on: [Primitives.limbs_to_num_cons, nth_tl, nth_succ_cons]
        notes: generalized with carry_in to make induction work; BigAdd_correct instantiates with carry_in=0
      BigAdd_correct:
        type: Theorem
        statement: limbs_to_num n a + limbs_to_num n b = limbs_to_num n out
        assumes:
          - k >= 1
          - length a = k, length b = k, length out = k + 1, length carries = k
          - "a[0] + b[0] = out[0] + carries[0] * 2^n"
          - "forall i, 0 < i < k -> a[i] + b[i] + carries[i-1] = out[i] + carries[i] * 2^n"
          - "out[k] = carries[k-1]"
        technique: instantiate bigadd_with_carry with carry_in = 0, lia
        depends_on: [bigadd_with_carry]
      BigAdd_field_safe:
        type: Theorem
        statement: for n <= 252 and k >= 1, all constraint values (a, b, sum limbs, carries) remain in [0, p_field)
        technique: bound analysis on sum limbs and carries with n <= 252
        depends_on: []
      BigAdd_complete:
        type: Theorem
        statement: for k >= 1, exists out carries satisfying all BigAdd constraints with limbs_to_num(a) + limbs_to_num(b) = limbs_to_num(out)
        technique: witness via big_add_witness, verify constraints via big_add_witness_aux_correct, value via bigadd_with_carry
        depends_on: [big_add_witness, big_add_witness_aux_correct, bigadd_with_carry]

  BigSub:
    source: bigint.circom:100-128
    constraints:
      - out[0] = a[0] - b[0] + borrows[0] * 2^n
      - out[i] = a[i] - borrows[i-1] - b[i] + borrows[i] * 2^n
      - out[k-1] = a[k-1] - borrows[k-2] - b[k-1]
    properties:
      bigsub_with_borrow:
        type: Lemma
        statement: limbs_to_num n a - borrow_in - limbs_to_num n b = limbs_to_num n out
        assumes:
          - length a = length b, length out = length a, length borrows = length a - 1
          - length a >= 2
          - "out[0] = a[0] - borrow_in - b[0] + borrows[0] * 2^n"
          - "forall i, 0 < i < length a - 1 -> out[i] = a[i] - borrows[i-1] - b[i] + borrows[i] * 2^n"
          - "out[length a - 1] = a[length a - 1] - borrows[length a - 2] - b[length a - 1]"
        technique: >
          induction on list a, destructing b/out/borrows in parallel.
          Two base cases: length a = 2 (k=2, destruct to exact elements,
          limbs_to_num_cons + limbs_to_num_nil + lia) and length a >= 3
          (inductive step). Inductive step: peel head, build shifted
          hypotheses H0'/Hmid'/Hfinal' via nth_succ_cons and nth_tl,
          apply IH with borrow_in = bw0 (first borrow), lia.
        depends_on: [Primitives.limbs_to_num_cons, nth_tl, nth_succ_cons]
        notes: >
          generalized with borrow_in for induction; BigSub_correct instantiates
          with borrow_in=0. Requires length a >= 2 (not 1) because k=1 has no borrows.
      BigSub_correct:
        type: Theorem
        statement: limbs_to_num n a - limbs_to_num n b = limbs_to_num n out
        assumes:
          - k >= 2
          - length a = k, length b = k, length out = k, length borrows = k - 1
          - "out[0] = a[0] - b[0] + borrows[0] * 2^n"
          - "forall i, 0 < i < k-1 -> out[i] = a[i] - borrows[i-1] - b[i] + borrows[i] * 2^n"
          - "out[k-1] = a[k-1] - borrows[k-2] - b[k-1]"
        technique: instantiate bigsub_with_borrow with borrow_in = 0, lia
        depends_on: [bigsub_with_borrow]
      BigSub_field_safe:
        type: Theorem
        statement: for n <= 252 and k >= 2, all constraint values (a, b, diff limbs, borrows) remain in [0, p_field)
        technique: bound analysis on diff limbs and borrows with n <= 252
        depends_on: []
      BigSub_complete:
        type: Theorem
        statement: for k >= 2 and a >= b, exists out borrows satisfying all BigSub constraints with limbs_to_num(a) - limbs_to_num(b) = limbs_to_num(out)
        technique: witness via big_sub_witness, verify constraints via big_sub_witness_aux_correct, value via bigsub_with_borrow
        depends_on: [big_sub_witness, big_sub_witness_aux_correct, bigsub_with_borrow]

  BigMultNoCarry:
    source: bigint.circom:179-206
    constraints:
      - out[l] = convolution_at a b l for each l
    properties:
      BigMultNoCarry_correct:
        type: Theorem
        statement: forall l, nth l out 0 = convolution_at a b l
        assumes:
          - ka >= 1, kb >= 1
          - length a = ka, length b = kb, length out = ka + kb - 1
          - out[l] = convolution_at a b l for all l
        technique: direct from assumption
        depends_on: [convolution_at]
        wiring: true
        notes: >
          convolution constraint wiring — restates the pointwise constraint.
          Strengthening to a polynomial product identity (limbs_to_num n out =
          limbs_to_num n a * limbs_to_num n b) requires a convolution-to-product
          lemma that is beyond the scope of individual circuit verification.

  BigMult:
    source: bigint.circom:132-174
    constraints:
      - rawLimbs = BigMultNoCarry(a, b)
      - carry propagation: rawLimbs -> out via carries
    properties:
      BigMult_carries_preserve:
        type: Theorem
        statement: limbs_to_num n rawLimbs = limbs_to_num n out
        assumes:
          - k >= 1
          - length rawLimbs = 2*k, length out = 2*k, length carries = 2*k - 1
          - "rawLimbs[0] = out[0] + carries[0] * 2^n"
          - "forall i, 0 < i < 2*k-1 -> rawLimbs[i] + carries[i-1] = out[i] + carries[i] * 2^n"
          - "out[2*k-1] = rawLimbs[2*k-1] + carries[2*k-2]"
        technique: >
          apply carry_propagation_preserves_value with carries ++ [0] (pad
          carries from 2k-1 to 2k entries; circuit has 2k-1 carries but the
          lemma needs 2k). Three cases: i=0 uses H0 with app_nth1,
          0 < i < 2k-1 uses Hmid with app_nth1 (for both carries[i] and
          carries[i-1]), i=2k-1 rewrites carries[2k-1] to 0 via
          replace (2*k-1) with (length carries + 0) then app_nth2_plus,
          then Z.mul_0_l eliminates the final carry term and lia closes.
          Last obligation: carries ++ [0] has final entry 0 by app_nth2_plus.
        depends_on:
          - Primitives.carry_propagation_preserves_value
      BigMult_field_safe:
        type: Theorem
        statement: for k >= 1 and 2*k*2^(2n) < p_field, all constraint values remain in field
        technique: bound analysis on raw limbs and carry values
        depends_on: []
      BigMult_complete:
        type: Theorem
        statement: for k >= 1 and length(rawLimbs) = 2k, exists out carries satisfying carry propagation constraints with limbs_to_num(rawLimbs) = limbs_to_num(out)
        technique: apply carry_propagation_complete, extract out limbs as remainders
        depends_on: [carry_propagation_complete]

  BigMod:
    source: bigint.circom:210-266
    constraints:
      - a = b * quotient + remainder (via diff limbs)
      - diff checked to zero via CheckCarryToZero
      - remainder < divisor (via BigLessThan)
    properties:
      BigMod_constraint_holds:
        type: Theorem
        statement: >
          limbs_to_num n a =
          limbs_to_num n b * limbs_to_num n quotient + limbs_to_num n remainder
        assumes:
          - length a = k+1, length b = k, length remainder = k, length quotient = 2
          - length diff = k+1
          - "limbs_to_num n diff = limbs_to_num n a - limbs_to_num n b * limbs_to_num n quotient - limbs_to_num n remainder"
          - limbs_to_num n diff = 0
        technique: substitute diff composition into diff=0, lia
        depends_on: []
        notes: derives modular equation a = b*quotient + remainder from diff=0 and composition
      BigMod_complete:
        type: Theorem
        statement: >
          for n >= 1, k >= 2, exists quotient remainder satisfying all BigMod constraints
          with a = b*quotient + remainder and remainder < b
        technique: witness quotient = A/B, remainder = A mod B, verify via Z.div_mod and Z.mod_pos_bound
        depends_on: [Primitives.num_to_limbs]

  BigSubModP:
    source: bigint.circom:268-308
    constraints:
      - out + b - a = multiple of p (via BigMod)
    properties:
      BigSubModP_complete:
        type: Theorem
        statement: >
          for n >= 1, k >= 2, exists out quotient satisfying all BigSubModP constraints
          with out = (a - b) mod p
        technique: witness out = ((A - B) mod P + P) mod P, verify constraints
        depends_on: [BigMod_complete]

  BigMultModP:
    source: bigint.circom:312-382
    constraints:
      - a * b = quotient * p + out (via BigMult and CheckCarryToZero)
      - out < p (via BigLessThan)
    properties:
      BigMultModP_complete:
        type: Theorem
        statement: >
          for n >= 1, k >= 2, exists out quotient satisfying all BigMultModP constraints
          with a*b = p*quotient + out and out < p
        technique: witness quotient = (A*B)/P, out = (A*B) mod P, verify via Z.div_mod and Z.mod_pos_bound
        depends_on: [Primitives.num_to_limbs]

  BigModInv:
    source: bigint.circom:384-405
    constraints:
      - out * a mod p = 1 (via BigMultModP)
    properties:
      BigModInv_complete:
        type: Theorem
        statement: >
          for n >= 1, k >= 2, exists inv satisfying all BigModInv constraints
          with (a * inv) mod p = 1 (axiomatized via mod_inv)
        technique: axiomatize modular inverse existence, verify BigMultModP constraints
        depends_on: [BigMultModP_complete]

  BigLessThan:
    source: bigint.circom:413-440
    constraints:
      - per-limb LessThan and IsEqual comparisons
      - out = big_lt_chain lt_vals eq_vals
    properties:
      big_lt_chain_binary:
        type: Lemma
        statement: is_binary (big_lt_chain lt_vals eq_vals)
        assumes:
          - length lt_vals = length eq_vals, length lt_vals >= 1
          - forall i, is_binary (nth i lt_vals 0)
          - forall i, is_binary (nth i eq_vals 0)
          - "forall i, nth i lt_vals 0 = 1 -> nth i eq_vals 0 = 0"
        technique: >
          induction on lt_vals. Base (singleton): binary from hypothesis.
          Recursive: change to l + e * recursive, case split on l/e binary.
          l=0,e=0 -> 0 (binary). l=0,e=1 -> recursive (binary by IH).
          l=1,e=0 -> 1 (binary). l=1,e=1 -> contradiction from mutual exclusivity.
        depends_on: [big_lt_chain, Primitives.is_binary]
      BigLessThan_correct:
        type: Theorem
        statement: is_binary out
        assumes:
          - k >= 1
          - length lt_vals = k, length eq_vals = k
          - forall i < k, is_binary (nth i lt_vals 0)
          - forall i < k, is_binary (nth i eq_vals 0)
          - "forall i < k, nth i lt_vals 0 = 1 -> nth i eq_vals 0 = 0"
          - out = big_lt_chain lt_vals eq_vals
        technique: subst out, apply big_lt_chain_binary
        depends_on: [big_lt_chain_binary, big_lt_chain]
        notes: derives binary output from mutual exclusivity of per-limb comparisons
      big_lt_chain_last_decides:
        type: Lemma
        statement: >
          big_lt_chain (l :: lrest) (e :: erest) =
          if l=1 then 1
          else if e=1 then big_lt_chain lrest erest
          else 0
        assumes: [is_binary l, is_binary e, l = 1 -> e = 0]
        technique: case analysis on l and e binary values
        depends_on: [Primitives.is_binary]
        notes: shows comparison chain short-circuits on first decisive limb

  BigIsEqual:
    source: bigint.circom:444-462
    constraints:
      - per-limb IsEqual comparisons -> eq_vals
      - out = product of eq_vals
    properties:
      BigIsEqual_correct:
        type: Theorem
        statement: out = 1 <-> Forall (fun x => x = 1) eq_vals
        assumes:
          - k >= 1
          - length eq_vals = k
          - Forall is_binary eq_vals
          - out = list_product eq_vals
        technique: apply binary_and_chain
        depends_on:
          - Primitives.binary_and_chain
          - Primitives.list_product
