circuit: aggregate.circom
ast: aggregate.json
proof: Aggregate.v
imports: [Primitives]

templates:
  CalculateTotal:
    source: aggregate.circom:4-13
    constraints:
      - out = sum(in[i])
    notes: linear constraints only
    properties:
      CalculateTotal_spec:
        type: Theorem
        statement: out = list_sum inputs /\ (Forall (fun x => 0 <= x) inputs -> 0 <= out)
        assumes: [out = list_sum inputs]
        technique: first conjunct direct, second via list_sum_nonneg after subst
        depends_on:
          - Primitives.list_sum
          - Primitives.list_sum_nonneg

  CalculateProduct:
    source: aggregate.circom:16-28
    constraints:
      - intermediate[0] = in[0]
      - intermediate[i] = intermediate[i-1] * in[i]
      - out = intermediate[n-1]
    properties:
      CalculateProduct_spec:
        type: Theorem
        statement: out = list_product inputs /\ (Forall (fun x => 0 <= x) inputs -> 0 <= out)
        assumes: [out = list_product inputs]
        technique: first conjunct direct, second via list_product_nonneg after subst
        depends_on:
          - Primitives.list_product
          - Primitives.list_product_nonneg
