circuit: elgamal.circom
ast: elgamal.json
proof: ElGamal.v
imports: [Primitives, Bitify, BabyJub, ScalarMul]

templates:
  ElGamalShare:
    source: elgamal.circom:11-20
    constraints:
      - yBits = Num2Bits(254)(y)
      - out = EscalarMulAny(254)(yBits, pubKey)
      - c1 = EscalarMulFix(254, BASE8)(yBits)
    notes: >
      computes shared secret out = pubKey^y and ephemeral key c1 = G8^y.
      Both use the same scalar y.
    properties:
      ElGamalBlinding_spec:
        type: Theorem
        statement: out = point_x - message
        assumes: [out = (message - point_x) * (-1)]
        technique: lia
        depends_on: []
        notes: from helpers.circom ElGamalBlinding template
      ElGamalMessageCheck_sound:
        type: Theorem
        statement: >
          a * (point_x^2) + point_y^2 = 1 + d * (point_x^2) * (point_y^2) /\
          message = point_x - blinding
        assumes:
          - x2 = point_x * point_x, y2 = point_y * point_y
          - a * x2 + y2 = 1 + d * x2 * y2
          - point_x - blinding = message
        technique: substitute x2/y2, split; first goal direct, second by lia
        depends_on:
          - BabyJub.BabyCheck_spec
        notes: from helpers.circom ElGamalMessageCheck template
      ElGamalShare_spec:
        type: Theorem
        statement: 0 <= y < 2^254
        assumes:
          - length yBits = 254, all_binary yBits
          - y = bits_to_num yBits
        technique: substitute y, apply bits_to_num_bound, rewrite length
        depends_on:
          - Primitives.bits_to_num_bound

  ElGamalEncrypt:
    source: elgamal.circom:25-44
    constraints:
      - shared = ElGamalShare(pubKey, y)
      - c1 = shared.c1
      - c2 = BabyAdd(message, shared.out)
    notes: >
      ElGamal encryption: c1 = G8^y, c2 = message + pubKey^y
    properties:
      ElGamalEncrypt_structure:
        type: Theorem
        statement: >
          (1 + d*tau) * c2_x = beta + gamma /\
          (1 - d*tau) * c2_y = delta + a*beta - gamma /\
          tau = msg_x * shared_y * (msg_y * shared_x)
        assumes:
          - BabyAdd constraints for c2 = message + shared
        technique: substitute beta/gamma/tau, first two goals direct, third by ring
        depends_on:
          - BabyJub.BabyAdd_spec

  ElGamalDecrypt:
    source: elgamal.circom:48-72
    constraints:
      - privKeyBits = Num2Bits(254)(privKey)
      - s = EscalarMulAny(254)(privKeyBits, c1)
      - c1xInvX = 0 - s.out[0] (negate x-coordinate)
      - message = BabyAdd((-s_x, s_y), c2)
    notes: >
      ElGamal decryption: message = c2 - c1^privKey.
      Negation inverts x-coordinate on twisted Edwards curve.
      Proof also covers helpers.circom templates (ElGamalBlinding,
      ElGamalMessageCheck) and algebraic roundtrip property.
    properties:
      ElGamalDecrypt_negation:
        type: Theorem
        statement: c1xInvX = -c1x_out_x
        assumes: [c1xInvX = 0 - c1x_out_x]
        technique: lia
        depends_on: []
      ElGamalDecrypt_structure:
        type: Theorem
        statement: >
          (1 + d*tau) * msg_x = beta + gamma /\
          (1 - d*tau) * msg_y = delta + a*beta - gamma /\
          tau = neg_s_x * c2_y * (s_y * c2_x) /\
          0 <= privKey < 2^254
        assumes:
          - length privKeyBits = 254, all_binary privKeyBits
          - privKey = bits_to_num privKeyBits
          - neg_s_x = -s_x
          - BabyAdd constraints for message = (-s, c2)
        technique: substitute beta/gamma/tau, first two direct, third by ring, fourth by bits_to_num_bound
        depends_on:
          - BabyJub.BabyAdd_spec
          - Primitives.bits_to_num_bound
      ElGamal_roundtrip_algebraic:
        type: Theorem
        statement: >
          point_add (point_add msg (scalar_mul y pubKey))
            (point_neg (scalar_mul privKey (scalar_mul y G))) = msg
        assumes:
          - pubKey = scalar_mul privKey G
          - abstract group law: associativity, commutativity, inverse, identity
          - scalar_mul commutativity
        technique: >
          substitute pubKey, rewrite scalar_mul_comm, apply point_add_assoc,
          apply point_add_neg, apply point_add_identity
        depends_on: []
        notes: >
          proven within a Section with abstract group law hypotheses.
          The extracted theorem takes group operations and their properties
          as explicit parameters.
