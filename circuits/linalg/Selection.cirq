circuit: selection.circom
ast: selection.json
proof: Selection.v
imports: [Primitives]

templates:
  Max:
    source: selection.circom:7-48
    constraints:
      - out = in[index] (via indicator mux)
      - out >= in[i] for all i (via LessThan comparisons)
    notes: prover witnesses the index; circuit verifies maximality
    properties:
      Max_correct:
        type: Theorem
        statement: forall i, nth i inputs 0 <= out
        assumes:
          - forall i < length inputs, out >= nth i inputs 0
          - In out (map ...) (membership witness — unused in proof)
        technique: specialize universal bound assumption, lia
        depends_on: []
        notes: >
          the membership assumption (out is an element of inputs) is declared
          but unused in the proof. The theorem only proves out >= all elements,
          not that out is itself an element. Max_ge_all proves the same thing
          without the unused assumption.
      Max_ge_all:
        type: Theorem
        statement: forall i, nth i inputs 0 <= out
        assumes:
          - forall i < length inputs, out >= nth i inputs 0
        technique: specialize universal bound assumption, lia
        depends_on: []
