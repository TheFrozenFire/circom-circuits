circuit: bitwise.circom
ast: bitwise.json
proof: Bitwise.v
imports: [Primitives]

templates:
  AND:
    source: bitwise.circom:6-14
    constraints:
      - equality = 2*a*b - a - b + 1
      - out = equality * b
    properties:
      AND_correct:
        type: Theorem
        statement: out = a * b /\ is_binary out
        assumes: [is_binary a, is_binary b, out = (2*a*b - a - b + 1) * b]
        technique: case analysis on a, b binary values
        depends_on: [Primitives.is_binary]

  OR:
    source: bitwise.circom:16-22
    constraints:
      - out = a + b - a * b
    properties:
      OR_correct:
        type: Theorem
        statement: (out = 1 <-> a = 1 \/ b = 1) /\ is_binary out
        assumes: [is_binary a, is_binary b, out = a + b - a * b]
        technique: case analysis on a, b binary values
        depends_on: [Primitives.is_binary]

  XOR:
    source: bitwise.circom:24-30
    constraints:
      - out = a + b - 2 * a * b
    properties:
      XOR_correct:
        type: Theorem
        statement: (out = 1 <-> a <> b) /\ is_binary out
        assumes: [is_binary a, is_binary b, out = a + b - 2*a*b]
        technique: case analysis on a, b binary values
        depends_on: [Primitives.is_binary]

  MUXOR:
    source: bitwise.circom:32-42
    constraints:
      - intermediate[0] = XOR(in[0], in[1])
      - intermediate[i] = XOR(intermediate[i-1], in[i+1])
      - out = intermediate[n-2]
    notes: result is fold_xor of all inputs
    properties:
      MUXOR_correct:
        type: Theorem
        statement: is_binary (fold_xor inputs)
        assumes: [2 <= length inputs, all_binary inputs]
        technique: induction on inputs list, apply xor_bit_binary at each step
        depends_on: [Primitives.xor_bit_binary, Primitives.fold_xor]

  MultiXOR:
    source: bitwise.circom:44-51
    constraints:
      - out[i] = in[0][i] + in[1][i] - 2 * in[0][i] * in[1][i]
    notes: each element is an independent pairwise XOR
    properties:
      MultiXOR_correct:
        type: Theorem
        statement: out = xor_bit a b /\ is_binary out
        assumes: [is_binary a, is_binary b, out = a + b - 2*a*b]
        technique: case analysis on a, b binary values
        depends_on: [Primitives.xor_bit, Primitives.is_binary]

  BitwiseNOT:
    source: bitwise.circom:95-101
    constraints:
      - out = 2^n - a - 1
    notes: linear constraint only, flips all bits of n-bit value
    properties:
      BitwiseNOT_spec:
        type: Theorem
        statement: 0 <= out < 2^n
        assumes:
          - 0 <= a < 2^n
          - out = 2^n - a - 1
        technique: lia from constraint and input range
        depends_on: []
        notes: derives output range preservation from input range and NOT formula
