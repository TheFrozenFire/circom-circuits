circuit: comparators.circom
ast: comparators.json
proof: Comparators.v
imports: [Primitives]

templates:
  IsZero:
    source: comparators.circom:6-15
    constraints:
      - out = 1 - inp * inv
      - inp * out = 0
    properties:
      IsZero_sound:
        type: Theorem
        statement: inp = 0 <-> out = 1
        assumes: [out = 1 - inp * inv, inp * out = 0]
        technique: case split on inp = 0, algebraic manipulation
        depends_on: []
      IsZero_binary:
        type: Theorem
        statement: is_binary out
        assumes: [out = 1 - inp * inv, inp * out = 0]
        technique: Z.mul_eq_0 to split product, case analysis on inp = 0
        depends_on: [Primitives.is_binary]
      IsZero_complete:
        type: Theorem
        statement: exists out inv in field such that (inp = 0 <-> out = 1) and inp * out = 0
        technique: witness inv = if inp = 0 then 0 else fp_inv(inp), verify constraints
        depends_on: [Primitives.fp_inv]

  IsEqual:
    source: comparators.circom:18-23
    constraints:
      - out = 1 - (b - a) * inv
      - (b - a) * out = 0
    notes: delegates to IsZero on (b - a)
    properties:
      IsEqual_sound:
        type: Theorem
        statement: a = b <-> out = 1
        assumes: [out = 1 - (b - a) * inv, "(b - a) * out = 0"]
        technique: rewrite to IsZero_sound on (b - a), lia
        depends_on: [IsZero_sound]
      IsEqual_complete:
        type: Theorem
        statement: exists out inv in field such that (a = b <-> out = 1)
        technique: delegate to IsZero_complete on (b - a)
        depends_on: [IsZero_complete]

  LessThan:
    source: comparators.circom:27-34
    constraints:
      - bits = Num2Bits(n+1)(a + 2^n - b)
      - out = 1 - bits[n]
    notes: >
      key idea: a + 2^n - b is computed as (n+1)-bit value.
      If a < b the value is in [0, 2^n) so bit n is 0 giving out = 1.
      If a >= b the value is in [2^n, 2^(n+1)) so bit n is 1 giving out = 0.
    properties:
      LessThan_sound:
        type: Theorem
        statement: a < b <-> out = 1
        assumes:
          - 0 < n
          - 0 <= a < 2^n
          - 0 <= b < 2^n
          - length bits = S n
          - all_binary bits
          - bits_to_num bits = a + 2^n - b
          - out = 1 - nth n bits 0
        technique: >
          split bits into firstn n and top bit via firstn_skipn_middle,
          use bits_to_num_app to decompose, case split on top bit value
        depends_on:
          - Primitives.all_binary
          - Primitives.bits_to_num
          - Primitives.bits_to_num_bound
          - Primitives.bits_to_num_app
      LessThan_field_safe:
        type: Theorem
        statement: for 0 < n <= 252, a, b, and a + 2^n - b remain in [0, p_field)
        technique: bound analysis on a + 2^n - b with n <= 252
        depends_on: []
      LessThan_complete:
        type: Theorem
        statement: for 0 < n and a, b < 2^n, exists bits, out satisfying LessThan constraints with (a < b <-> out = 1)
        technique: witness bits = Num2Bits(a + 2^n - b), derive top bit from range
        depends_on: [Num2BitsLE_complete]

  ForceEqualIfEnabled:
    source: comparators.circom:37-43
    constraints:
      - isEq = 1 - (b - a) * inv
      - (b - a) * isEq = 0
      - (1 - isEq) * enabled = 0
    properties:
      ForceEqualIfEnabled_sound:
        type: Theorem
        statement: enabled = 1 -> a = b
        assumes:
          - isEq = 1 - (b - a) * inv
          - (b - a) * isEq = 0
          - (1 - isEq) * enabled = 0
          - enabled = 1
        technique: derive isEq = 1 from force constraint, apply IsZero_sound
        depends_on: [IsZero_sound]
