circuit: babyjub.circom
ast: babyjub.json
proof: BabyJub.v
imports: [Primitives, Bitify, Comparators]

templates:
  BabyAdd:
    source: babyjub.circom:9-35
    constraints:
      - beta = x1 * y2
      - gamma = y1 * x2
      - delta = (-a*x1 + y1) * (x2 + y2)
      - tau = beta * gamma
      - (1 + d*tau) * xout = beta + gamma
      - (1 - d*tau) * yout = delta + a*beta - gamma
    notes: twisted Edwards point addition on BabyJubjub
    properties:
      BabyAdd_spec:
        type: Theorem
        statement: >
          (1 + d*tau) * xout = beta + gamma /\
          (1 - d*tau) * yout = delta + a*beta - gamma /\
          tau = x1*y2 * (y1*x2)
        assumes:
          - beta = x1 * y2, gamma = y1 * x2
          - delta = (-a*x1 + y1) * (x2 + y2)
          - tau = beta * gamma
          - (1 + d*tau) * xout = beta + gamma
          - (1 - d*tau) * yout = delta + a*beta - gamma
        technique: substitute beta/gamma/tau, first two goals direct, third by ring
        depends_on: []

      BabyAdd_is_group_op:
        type: Theorem
        statement: BabyAdd constraints match abstract group operation on on-curve points
        technique: substitute beta/gamma/tau, apply field inverse axiom for (1 + d*tau)
        depends_on: [BabyAdd_spec]
      BabyAdd_complete:
        type: Theorem
        statement: for on-curve points with (1 + d*tau) mod p != 0, exists xout yout beta gamma delta tau satisfying all BabyAdd constraints
        technique: witness field expressions, verify constraints via field arithmetic
        depends_on: [Primitives.fp_inv]

  BabyDbl:
    source: babyjub.circom:38-52
    constraints:
      - delegates to BabyAdd(P, P)
    notes: point doubling via self-addition
    properties:
      BabyDbl_spec:
        type: Theorem
        statement: beta = gamma /\ tau = beta * beta
        assumes:
          - BabyAdd constraints with (x2,y2) = (x1,y1)
        technique: substitute beta/gamma/tau from commutativity (x*y = y*x), ring
        depends_on: []

  BabyCheck:
    source: babyjub.circom:55-69
    constraints:
      - x2 = x * x
      - y2 = y * y
      - a * x2 + y2 = 1 + d * x2 * y2
    notes: twisted Edwards curve equation check
    properties:
      BabyCheck_spec:
        type: Theorem
        statement: a * (x*x) + y*y = 1 + d * (x*x) * (y*y)
        assumes:
          - x2 = x * x, y2 = y * y
          - a * x2 + y2 = 1 + d * x2 * y2
        technique: substitute x2 and y2
        depends_on: []

  BabyPointAdd:
    source: babyjub.circom:73-80
    constraints:
      - delegates to BabyAdd with array interface
    properties:
      BabyPointAdd_spec:
        type: Theorem
        statement: >
          (1 + d*tau) * outx = beta + gamma /\
          (1 - d*tau) * outy = delta + a*beta - gamma /\
          tau = x1*y2 * (y1*x2)
        assumes:
          - BabyAdd constraints (beta, gamma, delta, tau, two constraint equations)
        technique: delegate to BabyAdd_spec
        depends_on:
          - BabyAdd_spec

  BabySuborderCheck:
    source: babyjub.circom:95-101
    constraints:
      - diff = SUBORDER - 1 - in
      - Num2BitsLE(253)(diff) — binary decomposition exists
    notes: proves 0 <= in <= SUBORDER - 1
    properties:
      BabySuborderCheck_spec:
        type: Theorem
        statement: inp <= suborder - 1
        assumes:
          - suborder > 0
          - diff = suborder - 1 - inp
          - length bits = 253, all_binary bits
          - diff = bits_to_num bits
        technique: >
          derive bits_to_num bits >= 0 via bits_to_num_nonneg,
          rewrite diff, lia
        depends_on:
          - Primitives.bits_to_num_nonneg

  BabySuborderAdd:
    source: babyjub.circom:105-120
    constraints:
      - sum = a + b
      - k = sum \ q (Euclidean quotient)
      - out = sum - k * q
      - LessThan(252)(out, q) = 1
    notes: scalar addition modulo suborder
    properties:
      BabySuborderAdd_spec:
        type: Theorem
        statement: out = (a + b) mod q
        assumes:
          - q > 0
          - sum = a + b
          - out = sum - k * q
          - 0 <= out < q
        technique: substitute sum/out, apply Zmod_unique with quotient k
        depends_on: []
      BabySuborderAdd_field_safe:
        type: Theorem
        statement: for a, b in suborder, a, b, and (a + b) remain in field
        technique: bound analysis on a + b with suborder < p_field
        depends_on: []
      BabySuborderAdd_complete:
        type: Theorem
        statement: for q > 0 and a + b >= 0, exists out k such that out < q and out = (a + b) mod q
        technique: witness out = (a + b) mod q, k = (a + b) / q, verify via Z.mod_pos_bound
        depends_on: []
