circuit: montgomery.circom
ast: montgomery.json
proof: Montgomery.v
imports: [Primitives]

templates:
  Edwards2Montgomery:
    source: montgomery.circom:6-15
    constraints:
      - out[0] * (1 - in[1]) = 1 + in[1]
      - out[1] * in[0] = out[0]
    notes: >
      converts Edwards point to Montgomery: u = (1+y)/(1-y), v = u/x.
      Constraints encode the division as multiplication.
    properties:
      Edwards2Montgomery_spec:
        type: Theorem
        statement: v * x * (1 - y) = 1 + y
        assumes:
          - u * (1 - y) = 1 + y
          - v * x = u
        technique: substitute u (= v*x) into first constraint, lia
        depends_on: []
      Edwards2Montgomery_welldefined:
        type: Theorem
        statement: (1 - y) /= 0 /\ x /= 0
        assumes:
          - y /= 1, x /= 0
          - u * (1 - y) = 1 + y
          - v * x = u
        technique: lia from y /= 1 and x /= 0
        depends_on: []

  Montgomery2Edwards:
    source: montgomery.circom:18-27
    constraints:
      - out[0] * in[1] = in[0]
      - out[1] * (in[0] + 1) = in[0] - 1
    notes: converts Montgomery point to Edwards: x = u/v, y = (u-1)/(u+1)
    properties:
      Montgomery2Edwards_spec:
        type: Theorem
        statement: y * (x * v + 1) = x * v - 1
        assumes:
          - x * v = u
          - y * (u + 1) = u - 1
        technique: substitute u (= x*v) into second constraint, lia
        depends_on: []

  MontgomeryAdd:
    source: montgomery.circom:33-51
    constraints:
      - lambda * (x2 - x1) = y2 - y1
      - x3 = B * lambda^2 - A - x1 - x2
      - y3 = lambda * (x1 - x3) - y1
    notes: standard Montgomery curve addition law in constraint form
    properties:
      MontgomeryAdd_spec:
        type: Theorem
        statement: y3 = lambda * (x1 - (B * lambda^2 - A - x1 - x2)) - y1
        assumes:
          - lambda * (x2 - x1) = y2 - y1
          - x3 = B * lambda * lambda - A - x1 - x2
          - y3 = lambda * (x1 - x3) - y1
        technique: substitute x3 into y3 equation, lia
        depends_on: []

  MontgomeryDouble:
    source: montgomery.circom:57-77
    constraints:
      - x1_2 = x1 * x1
      - lambda * (2 * B * y1) = 3 * x1_2 + 2 * A * x1 + 1
      - x3 = B * lambda^2 - A - 2 * x1
      - y3 = lambda * (x1 - x3) - y1
    notes: standard Montgomery curve doubling in constraint form
    properties:
      MontgomeryDouble_spec:
        type: Theorem
        statement: >
          lambda * (2*B*y1) = 3*x1^2 + 2*A*x1 + 1 /\
          y3 = lambda * (x1 - (B*lambda^2 - A - 2*x1)) - y1
        assumes:
          - x1_2 = x1 * x1
          - lambda * (2 * B * y1) = 3 * x1_2 + 2 * A * x1 + 1
          - x3 = B * lambda * lambda - A - 2 * x1
          - y3 = lambda * (x1 - x3) - y1
        technique: substitute x1_2 and x3, lia
        depends_on: []
