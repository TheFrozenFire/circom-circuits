circuit: commit.circom
ast: commit.json
proof: Commit.v
imports: [Primitives]

templates:
  VectorCommit:
    source: commit.circom:10-42
    constraints:
      - chunkHash[i] = Poseidon(chunkSize)(v[i*chunkSize..(i+1)*chunkSize-1])
      - nodes[nChunks-1+i] = chunkHash[i] (leaves)
      - nodes[i] = Poseidon(2)(nodes[2i+1], nodes[2i+2]) (internal nodes)
      - out = nodes[0] (root)
    notes: >
      chunked Poseidon hashing with binary tree reduction. Splits vector
      into nChunks groups, hashes each with Poseidon(chunkSize), reduces
      via binary tree of Poseidon(2). Uses heap layout for tree.
    properties:
      VectorCommit_deterministic:
        type: Theorem
        statement: out1 = out2
        assumes:
          - length v = n, chunkSize > 0, n mod chunkSize = 0
          - out1 = compute v, out2 = compute v (same function and input)
        technique: substitute out1 and out2, reflexivity
        depends_on: []
      VectorCommit_tree_structure:
        type: Theorem
        statement: nth 0 nodes 0 = nth 0 treeHashes 0
        assumes:
          - nChunks > 1
          - length nodes = 2 * nChunks - 1
          - leaves are chunk hashes
          - internal nodes are Poseidon(2) of children
        technique: apply internal node hypothesis with i=0, lia for bound
        depends_on: []
      VectorCommit_same_input_same_output:
        type: Theorem
        statement: out1 = out2
        assumes:
          - v1 = v2, length v1 = n, length v2 = n
          - out1 = compute v1, out2 = compute v2 (same function)
        technique: substitute v2, out1, out2, reflexivity
        depends_on: []
